# Copy to .env.local for local use, and add the same values in your host's settings (e.g. Vercel → Project → Settings → Environment Variables).

# 1. Your domain, with https and no trailing slash. Used for canonical URLs, the sitemap,
#    robots.txt, Open Graph and structured data. REQUIRED before launch.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 2. Google Search Console → Add property → HTML tag method → copy only the content="…" value.
GOOGLE_SITE_VERIFICATION=

# 3. Contact form email (https://resend.com). Without these, the form opens the visitor's
#    own email app with the message filled in, so no message is lost.
RESEND_API_KEY=
CONTACT_TO=parsa.alizadeh.inet@gmail.com
# Optional: a sender on a domain you verified in Resend, e.g. "Website <hello@your-domain.com>"
CONTACT_FROM=
